{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinapsi.io/hive/domain-model.schema.json",
  "title": "Hive Domain Model",
  "type": "object",
  "required": ["schemaVersion", "context", "packageName", "aggregates"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "context": { "type": "string", "minLength": 1 },
    "packageName": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*(\\.[A-Za-z_$][\\w$]*)*$" },
    "aggregates": { "type": "array", "items": { "$ref": "#/$defs/aggregate" } },
    "useCases": { "type": "array", "items": { "$ref": "#/$defs/useCase" } }
  },
  "$defs": {
    "javaName": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "properties": { "name": { "$ref": "#/$defs/javaName" }, "type": { "type": "string", "minLength": 1 } }
    },
    "aggregate": {
      "type": "object",
      "required": ["name", "id"],
      "properties": {
        "name": { "$ref": "#/$defs/javaName" },
        "id": { "$ref": "#/$defs/field" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "behaviors": { "type": "array" },
        "events": { "type": "array" }
      }
    },
    "useCase": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/javaName" },
        "commandFields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "factory": { "type": "boolean" }
      }
    }
  }
}
